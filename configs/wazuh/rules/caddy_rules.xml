<group name="caddy,web,accesslog,">

  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="logger">^http.log.access</field>
    <description>Caddy: web request</description>
  </rule>

  <rule id="100210" level="10">
    <if_sid>100200</if_sid>
    <field name="request.uri" type="pcre2">(?i)/\.(env|git|aws|ssh|htpasswd)|wp-admin|wp-login|phpmyadmin|/server-status|/actuator</field>
    <description>Caddy: probe for secrets or admin pages: $(request.uri) from $(request.remote_ip)</description>
    <mitre><id>T1595.003</id></mitre>
    <group>web_scan,attack,</group>
  </rule>

  <rule id="100211" level="10">
    <if_sid>100200</if_sid>
    <field name="request.uri" type="pcre2">(?i)union(\s|%20|\+)+select|sleep\(|%27|\.\./|%2e%2e%2f|&lt;script|%3cscript</field>
    <description>Caddy: injection or path traversal attempt in URL from $(request.remote_ip)</description>
    <mitre><id>T1190</id></mitre>
    <group>web_attack,attack,</group>
  </rule>

  <rule id="100212" level="8">
    <if_sid>100200</if_sid>
    <field name="request.headers.User-Agent" type="pcre2">(?i)sqlmap|nikto|nmap|masscan|zgrab|gobuster|dirbuster|ffuf|wpscan|nuclei|feroxbuster</field>
    <description>Caddy: known attack tool in User-Agent from $(request.remote_ip)</description>
    <mitre><id>T1595</id></mitre>
    <group>web_scan,</group>
  </rule>

  <rule id="100201" level="0">
    <if_sid>100200</if_sid>
    <status type="pcre2">^4\d\d$</status>
    <description>Caddy: client error on $(request.uri) from $(request.remote_ip)</description>
  </rule>

  <rule id="100202" level="0">
    <if_sid>100201</if_sid>
    <field name="request.method">^PATCH$</field>
    <field name="request.uri" type="pcre2">^/api/v1/zikr/\d+/progress(\?|$)</field>
    <status type="pcre2">^403$</status>
    <description>Caddy: progress update from anonymous listener rejected (expected behaviour)</description>
  </rule>

  <rule id="100220" level="10" frequency="20" timeframe="60" ignore="60">
    <if_matched_sid>100201</if_matched_sid>
    <same_field>request.remote_ip</same_field>
    <description>Caddy: 20 client errors in 60 seconds from $(request.remote_ip), possible scan</description>
    <mitre><id>T1595.003</id></mitre>
    <group>web_scan,</group>
  </rule>

</group>
