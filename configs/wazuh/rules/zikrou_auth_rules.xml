<group name="zikrou,auth,">

  <rule id="100300" level="0">
    <decoded_as>json</decoded_as>
    <field name="log.logger" type="pcre2">^SECURITY_AUDIT$</field>
    <description>Zikrou API: security audit event</description>
  </rule>

  <rule id="100301" level="5">
    <if_sid>100300</if_sid>
    <field name="audit_event" type="pcre2">^login_failure$</field>
    <description>Zikrou API: failed login on account $(account) from $(src_ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100302" level="3">
    <if_sid>100300</if_sid>
    <field name="audit_event" type="pcre2">^login_success$</field>
    <description>Zikrou API: successful login on account $(account) from $(src_ip)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100310" level="10" frequency="5" timeframe="120" ignore="120">
    <if_matched_sid>100301</if_matched_sid>
    <same_field>account</same_field>
    <description>Zikrou API: brute force, 5 failed logins on account $(account) in 2 minutes</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,attack,</group>
  </rule>

  <rule id="100311" level="12" frequency="8" timeframe="300" ignore="300">
    <if_matched_sid>100301</if_matched_sid>
    <same_field>src_ip</same_field>
    <different_field>account</different_field>
    <description>Zikrou API: credential stuffing, failed logins on many accounts from $(src_ip)</description>
    <mitre><id>T1110.004</id></mitre>
    <group>authentication_failures,attack,</group>
  </rule>

  <rule id="100312" level="13" timeframe="600">
    <if_sid>100302</if_sid>
    <if_matched_sid>100310</if_matched_sid>
    <same_field>account</same_field>
    <description>Zikrou API: successful login on account $(account) after a brute force, possible compromise</description>
    <mitre><id>T1110</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100320" level="3">
    <if_sid>100300</if_sid>
    <field name="audit_event" type="pcre2">^reset_code_failure$</field>
    <description>Zikrou API: reset code rejected ($(reason)) for account $(account)</description>
  </rule>

  <rule id="100322" level="5">
    <if_sid>100320</if_sid>
    <field name="reason" type="pcre2">^wrong_code$</field>
    <description>Zikrou API: wrong reset code for account $(account) from $(src_ip)</description>
  </rule>

  <rule id="100323" level="12" frequency="4" timeframe="900" ignore="300">
    <if_matched_sid>100322</if_matched_sid>
    <same_field>account</same_field>
    <description>Zikrou API: more than 3 wrong reset codes on account $(account), attempt limit bypassed</description>
    <mitre><id>T1110</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100324" level="3">
    <if_sid>100300</if_sid>
    <field name="audit_event" type="pcre2">^password_reset_success$</field>
    <description>Zikrou API: password reset for account $(account)</description>
  </rule>

  <rule id="100325" level="14" timeframe="900">
    <if_sid>100324</if_sid>
    <if_matched_sid>100322</if_matched_sid>
    <same_field>account</same_field>
    <description>Zikrou API: password reset after wrong codes on account $(account), possible account takeover</description>
    <mitre><id>T1098</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100330" level="10">
    <if_sid>100300</if_sid>
    <field name="audit_event" type="pcre2">^refresh_token_failure$</field>
    <field name="reason" type="pcre2">^revoked$</field>
    <description>Zikrou API: revoked refresh token reused from $(src_ip), possible stolen token</description>
    <mitre><id>T1550.001</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100340" level="7">
    <if_sid>100300</if_sid>
    <field name="audit_event" type="pcre2">^rate_limited$</field>
    <description>Zikrou API: rate limit hit on $(reason) from $(src_ip)</description>
  </rule>

  <rule id="100350" level="3">
    <if_sid>100300</if_sid>
    <field name="audit_event" type="pcre2">^register_duplicate$</field>
    <description>Zikrou API: signup with an existing email from $(src_ip)</description>
  </rule>

  <rule id="100351" level="8" frequency="5" timeframe="300" ignore="300">
    <if_matched_sid>100350</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Zikrou API: account enumeration through signup from $(src_ip)</description>
    <mitre><id>T1589.002</id></mitre>
    <group>attack,</group>
  </rule>

<rule id="100321" level="8">
  <if_sid>100320</if_sid>
  <field name="reason">^too_many_attempts$</field>
  <description>Zikrou API: reset code locked after too many wrong attempts on account $(account)</description>
  <mitre>
    <id>T1110.001</id>
  </mitre>
</rule>

</group>
